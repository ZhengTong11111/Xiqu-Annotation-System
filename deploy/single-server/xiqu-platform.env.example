# 生产进程边界：部署时复制到 /etc/xiqu-platform/xiqu-platform.env，并设置 chmod 600。
NODE_ENV=production
PORT=4317
HOST=127.0.0.1
DATABASE_URL='postgresql://xiqu_app:replace-with-strong-password@127.0.0.1:5432/xiqu_platform?schema=public'

# 生产默认绝不能写入 admin/admin123 等开发种子账号。
XIQU_SEED_DEVELOPMENT_DATA=false

# 同源 Nginx 部署不设置 XIQU_CORS_ORIGINS。只有确有独立 Web origin 时才写有限列表。
# XIQU_CORS_ORIGINS=https://annotation.example.org

# local 对象存储必须位于 release 目录之外，并由 xiqu 服务账号独占写权限。
XIQU_OBJECT_STORAGE_BACKEND='local'
XIQU_STORAGE_ROOT='/var/lib/xiqu-platform/storage'

# 若改用 S3-compatible，删除 XIQU_STORAGE_ROOT 并补齐以下全部变量。
# XIQU_OBJECT_STORAGE_BACKEND='s3'
# XIQU_S3_ENDPOINT='https://s3.example.org'
# XIQU_S3_REGION='us-east-1'
# XIQU_S3_BUCKET='xiqu-platform'
# XIQU_S3_ACCESS_KEY_ID='replace-me'
# XIQU_S3_SECRET_ACCESS_KEY='replace-me'
# XIQU_S3_FORCE_PATH_STYLE=true
# XIQU_S3_PREFIX='platform-objects'

XIQU_AUTH_TOKEN_DAYS=14
XIQU_METRICS_TOKEN='replace-with-long-random-token'
XIQU_OPERATIONAL_METRICS_TIMEOUT_MS=5000
# 单文件上限。未设置时默认等于用户配额（单文件不可能超过账号配额，故以配额为上限，无人为天花板）。
# size 列已迁 BigInt，可设为超过 2 GiB；调大时 Nginx 的 client_max_body_size 必须同步调大。
# XIQU_MAX_UPLOAD_BYTES=1073741824
XIQU_USER_STORAGE_QUOTA_BYTES=21474836480
XIQU_PLATFORM_STORAGE_QUOTA_BYTES=214748364800
XIQU_ORPHAN_GRACE_MS=86400000
LOG_LEVEL='info'
