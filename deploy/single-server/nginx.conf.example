# 放入 /etc/nginx/conf.d/xiqu-platform.conf 前替换域名和证书路径。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name annotation.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name annotation.example.org;

    ssl_certificate /etc/letsencrypt/live/annotation.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/annotation.example.org/privkey.pem;

    root /opt/xiqu/current/dist;
    index index.html;
    # 与 env.example 的默认 20 GiB 单文件/账号配额对齐；否则 Nginx 会先于 Fastify 返回 413。
    # 调整 XIQU_MAX_UPLOAD_BYTES 时必须同步修改这里，生产上线前还要按真实存储容量复核。
    client_max_body_size 20g;

    # 分析瓦片是结构化二进制，真实频谱通常仍有可观压缩空间；由 Nginx 流式压缩，API 无需缓冲整批响应。
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types
        application/vnd.xiqu.waveform-tile
        application/vnd.xiqu.spectrogram-tile
        application/vnd.xiqu.pitch-tile
        application/vnd.xiqu.media-analysis-batch;

    # /api 必须先于 SPA fallback；同一入口同时承载普通 HTTP 和认证 WebSocket upgrade。
    location /api/ {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # 大媒体上传与协作 WebSocket 都走该 location；放宽读/写间隔，避免慢速大文件或空闲 WS 被提前断开。
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }

    # 带内容哈希的 Vite 资产可长期缓存；index.html 不缓存，确保升级后及时发现新入口。
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
