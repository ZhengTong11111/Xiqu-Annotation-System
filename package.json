{
  "name": "xiqu-annotation-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "predev:api": "npm run build:shared && npm run build:document-model",
    "dev:api": "tsx apps/api/src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "build": "npm run db:generate && npm run build:shared && npm run build:document-model && npm run build:web && npm run build:api",
    "build:web": "tsc -p tsconfig.app.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit --incremental false && vite build",
    "build:shared": "tsc -p packages/shared/tsconfig.json",
    "build:document-model": "tsc -p packages/document-model/tsconfig.json",
    "test:permissions": "npm run build:shared && npm run build:document-model && node --test packages/document-model/test/permissions.test.mjs",
    "test:annotation-confirmations": "npm run build:shared && npm run build:document-model && node --test packages/document-model/test/annotation-confirmations.test.mjs",
    "test:resource-columns": "node --import tsx --test src/platform/resourceColumnModel.test.ts",
    "test:recovery-preview": "node --import tsx --test src/platform/recoverySnapshotPreview.test.ts",
    "test:recovery-comparison": "node --import tsx --test src/platform/recoverySnapshotComparison.test.ts",
    "test:annotation-diff": "node --import tsx --test src/platform/annotationDiff.test.ts",
    "test:annotation-diff-timeline": "node --import tsx --test src/platform/annotationDiffTimeline.test.ts",
    "test:annotation-comparison-navigation": "node --import tsx --test src/platform/annotationComparisonNavigation.test.ts",
    "test:annotation-merge-plan": "node --import tsx --test src/platform/annotationMergePlan.test.ts",
    "test:annotation-merge-selection": "node --import tsx --test src/platform/annotationMergeSelection.test.ts",
    "test:annotation-merge-conflict": "node --import tsx --test src/platform/annotationMergeConflict.test.ts",
    "test:annotation-merge-apply": "node --import tsx --test src/platform/annotationMergeApply.test.ts",
    "test:annotation-merge-preparation": "node --import tsx --test src/platform/annotationMergePreparation.test.ts",
    "test:resource-comparison": "node --import tsx --test src/platform/resourceComparison.test.ts",
    "test:api": "npm run build:shared && npm run build:document-model && tsc -p apps/api/tsconfig.test.json && tsx apps/api/test/prepareTestDatabase.ts && node --import tsx --test --test-concurrency=1 apps/api/test/*.test.ts",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start:api": "node dist/api/server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "fastify": "^5.8.5",
    "lucide-react": "^1.27.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
