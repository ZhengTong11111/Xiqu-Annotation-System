generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  super_admin
  admin
  teacher
  ta
  annotator
  reviewer
  service
}

enum ProjectMemberRole {
  manager
  reviewer
  annotator
  viewer
}

enum ProjectCapability {
  view_project
  create_workspace
  fork_version
  complete_version
  submit_version
  review_versions
  create_project_version
  publish_project_version
  manage_all_versions
  manage_members
}

enum WorkspaceType {
  main
  personal
  collaborative
}

enum WorkspaceStatus {
  active
  submitted
  archived
}

enum AnnotationVersionKind {
  checkpoint
  submission
}

enum AnnotationVersionStatus {
  active
  archived
}

enum ProjectVersionStatus {
  candidate
  published
  superseded
  archived
}

enum ProcessingJobType {
  pitch_extraction
  spectrogram_generation
  staff_notation_render
  gongche_render
  pose_estimation
  video_transcode
  audio_extract
  annotation_export
}

enum ProcessingJobStatus {
  queued
  running
  succeeded
  failed
}

enum AuditAction {
  auth_login
  file_upload
  media_create
  project_create
  workspace_create
  workspace_save
  workspace_status_update
  annotation_version_create
  annotation_version_archive
  annotation_version_fork
  project_version_create
  project_version_publish
  project_version_archive
  job_create
  permission_denied
  project_member_add
  project_member_update
  project_member_remove
}

enum AnnotationOperationStatus {
  accepted
  rejected
  superseded
}

model User {
  id           String   @id @default(uuid())
  accountName  String   @unique @map("account_name")
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                     UserRole[]
  sessions                  Session[]
  ownedFiles                FileObject[]          @relation("FileOwner")
  ownedMediaAssets          MediaAsset[]          @relation("MediaAssetOwner")
  projects                  AnnotationProject[]   @relation("ProjectOwner")
  ownedWorkspaces           AnnotationWorkspace[] @relation("WorkspaceOwner")
  createdWorkspaces         AnnotationWorkspace[] @relation("WorkspaceCreator")
  snapshots                 AnnotationSnapshot[]  @relation("SnapshotCreator")
  annotationVersions        AnnotationVersion[]   @relation("AnnotationVersionCreator")
  createdProjectVersions    ProjectVersion[]      @relation("ProjectVersionCreator")
  publishedProjectVersions  ProjectVersion[]      @relation("ProjectVersionPublisher")
  jobs                      ProcessingJob[]        @relation("JobCreator")
  auditLogs                 AuditLog[]             @relation("AuditActor")
  annotationOperations      AnnotationOperation[] @relation("AnnotationOperationActor")
  projectMemberships        ProjectMember[]

  @@map("users")
}

model UserRole {
  id     String       @id @default(uuid())
  userId String       @map("user_id")
  role   PlatformRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model FileObject {
  id          String   @id @default(uuid())
  name        String
  mimeType    String   @map("mime_type")
  size        Int
  storageKey  String   @unique @map("storage_key")
  checksum    String?
  ownerUserId String   @map("owner_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  owner       User         @relation("FileOwner", fields: [ownerUserId], references: [id])
  mediaAssets MediaAsset[] @relation("PrimaryMediaFile")
  auditLogs   AuditLog[]

  @@index([ownerUserId])
  @@map("files")
}

model MediaAsset {
  id            String   @id @default(uuid())
  title         String
  description   String?
  primaryFileId String?  @map("primary_file_id")
  ownerUserId   String?  @map("owner_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  primaryFile FileObject?        @relation("PrimaryMediaFile", fields: [primaryFileId], references: [id], onDelete: SetNull)
  owner       User?              @relation("MediaAssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  projects    AnnotationProject[]

  @@index([primaryFileId])
  @@index([ownerUserId])
  @@map("media_assets")
}

model AnnotationProject {
  id                      String   @id @default(uuid())
  title                   String
  mediaAssetId            String   @map("media_asset_id")
  ownerUserId             String   @map("owner_user_id")
  primaryWorkspaceId      String?  @unique @map("primary_workspace_id")
  currentProjectVersionId String?  @unique @map("current_project_version_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  mediaAsset            MediaAsset          @relation(fields: [mediaAssetId], references: [id])
  owner                 User                @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  primaryWorkspace      AnnotationWorkspace? @relation("PrimaryWorkspace", fields: [primaryWorkspaceId], references: [id], onDelete: SetNull)
  currentProjectVersion ProjectVersion?      @relation("CurrentProjectVersion", fields: [currentProjectVersionId], references: [id], onDelete: SetNull)
  workspaces            AnnotationWorkspace[] @relation("ProjectWorkspaces")
  annotationVersions    AnnotationVersion[]
  projectVersions       ProjectVersion[]     @relation("ProjectVersions")
  jobs                  ProcessingJob[]
  auditLogs             AuditLog[]
  members               ProjectMember[]

  @@index([mediaAssetId])
  @@index([ownerUserId])
  @@map("annotation_projects")
}

// 项目成员是项目权限的唯一来源。角色只提供默认能力模板，实际能力、时间和轨道范围
// 都保存在成员记录上，避免成员身份与授权范围形成两套可能不一致的真相。
model ProjectMember {
  id               String              @id @default(uuid())
  projectId        String              @map("project_id")
  userId           String              @map("user_id")
  role             ProjectMemberRole
  capabilities     ProjectCapability[]
  allowedStartTime Float?              @map("allowed_start_time")
  allowedEndTime   Float?              @map("allowed_end_time")
  allowedTrackIds  String[]            @default([]) @map("allowed_track_ids")
  expiresAt        DateTime?           @map("expires_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  project AnnotationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model AnnotationWorkspace {
  id                  String          @id @default(uuid())
  projectId           String          @map("project_id")
  name                String
  workspaceType       WorkspaceType   @map("workspace_type")
  status              WorkspaceStatus @default(active)
  ownerUserId         String          @map("owner_user_id")
  createdBy           String          @map("created_by")
  forkedFromVersionId String?         @map("forked_from_version_id")
  latestSnapshotId    String?         @unique @map("latest_snapshot_id")
  submittedAt         DateTime?       @map("submitted_at")
  archivedAt          DateTime?       @map("archived_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  project             AnnotationProject  @relation("ProjectWorkspaces", fields: [projectId], references: [id], onDelete: Cascade)
  primaryForProject   AnnotationProject? @relation("PrimaryWorkspace")
  owner               User               @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  creator             User               @relation("WorkspaceCreator", fields: [createdBy], references: [id])
  forkedFromVersion   AnnotationVersion? @relation("WorkspaceForkSource", fields: [forkedFromVersionId], references: [id], onDelete: SetNull)
  latestSnapshot      AnnotationSnapshot? @relation("LatestWorkspaceSnapshot", fields: [latestSnapshotId], references: [id], onDelete: SetNull)
  snapshots           AnnotationSnapshot[] @relation("WorkspaceSnapshots")
  versions            AnnotationVersion[]
  jobs                ProcessingJob[]
  auditLogs           AuditLog[]
  operations          AnnotationOperation[]

  @@index([projectId])
  @@index([ownerUserId])
  @@index([forkedFromVersionId])
  @@map("annotation_workspaces")
}

model AnnotationSnapshot {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  revision    Int
  payload     Json
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace       AnnotationWorkspace  @relation("WorkspaceSnapshots", fields: [workspaceId], references: [id], onDelete: Cascade)
  latestWorkspace AnnotationWorkspace? @relation("LatestWorkspaceSnapshot")
  creator         User                 @relation("SnapshotCreator", fields: [createdBy], references: [id])
  versions        AnnotationVersion[]

  @@unique([workspaceId, revision])
  @@index([createdBy])
  @@map("annotation_snapshots")
}

model AnnotationVersion {
  id              String                  @id @default(uuid())
  projectId       String                  @map("project_id")
  workspaceId     String                  @map("workspace_id")
  snapshotId      String                  @map("snapshot_id")
  parentVersionId String?                 @map("parent_version_id")
  name            String
  description     String?
  kind            AnnotationVersionKind
  status          AnnotationVersionStatus @default(active)
  createdBy       String                  @map("created_by")
  completedAt     DateTime                @default(now()) @map("completed_at")
  archivedAt      DateTime?               @map("archived_at")
  createdAt       DateTime                @default(now()) @map("created_at")

  project          AnnotationProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace        AnnotationWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot         AnnotationSnapshot    @relation(fields: [snapshotId], references: [id])
  parentVersion    AnnotationVersion?    @relation("AnnotationVersionAncestry", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions    AnnotationVersion[]   @relation("AnnotationVersionAncestry")
  forkedWorkspaces AnnotationWorkspace[] @relation("WorkspaceForkSource")
  creator          User                  @relation("AnnotationVersionCreator", fields: [createdBy], references: [id])
  projectVersions  ProjectVersion[]
  auditLogs        AuditLog[]

  @@index([projectId, completedAt])
  @@index([workspaceId, completedAt])
  @@index([snapshotId])
  @@index([parentVersionId])
  @@map("annotation_versions")
}

model ProjectVersion {
  id              String               @id @default(uuid())
  projectId       String               @map("project_id")
  sourceVersionId String               @map("source_version_id")
  sequence        Int
  name            String
  description     String?
  status          ProjectVersionStatus @default(candidate)
  createdBy       String               @map("created_by")
  publishedBy     String?              @map("published_by")
  publishedAt     DateTime?            @map("published_at")
  archivedAt      DateTime?            @map("archived_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  project           AnnotationProject  @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  currentForProject AnnotationProject? @relation("CurrentProjectVersion")
  sourceVersion     AnnotationVersion  @relation(fields: [sourceVersionId], references: [id])
  creator           User               @relation("ProjectVersionCreator", fields: [createdBy], references: [id])
  publisher         User?              @relation("ProjectVersionPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)
  auditLogs         AuditLog[]

  @@unique([projectId, sequence])
  @@index([sourceVersionId])
  @@index([projectId, status])
  @@map("project_versions")
}

model ProcessingJob {
  id            String              @id @default(uuid())
  type          ProcessingJobType
  status        ProcessingJobStatus @default(queued)
  inputFileIds  String[]            @map("input_file_ids")
  outputFileIds String[]            @default([]) @map("output_file_ids")
  projectId     String?             @map("project_id")
  workspaceId   String?             @map("workspace_id")
  createdBy     String              @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  errorMessage  String?             @map("error_message")

  project   AnnotationProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspace AnnotationWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creator   User                 @relation("JobCreator", fields: [createdBy], references: [id])
  auditLogs AuditLog[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([createdBy])
  @@map("processing_jobs")
}

// 审计只存动作摘要，不存完整标注 payload。目标对象删除时使用 SetNull，
// 这样项目版本的来源和责任人仍可从历史记录中追溯。
model AuditLog {
  id                  String      @id @default(uuid())
  action              AuditAction
  actorUserId         String?     @map("actor_user_id")
  projectId           String?     @map("project_id")
  workspaceId         String?     @map("workspace_id")
  annotationVersionId String?     @map("annotation_version_id")
  projectVersionId    String?     @map("project_version_id")
  fileId              String?     @map("file_id")
  jobId               String?     @map("job_id")
  targetType          String?     @map("target_type")
  targetId            String?     @map("target_id")
  detail              Json?
  ipAddress           String?     @map("ip_address")
  userAgent           String?     @map("user_agent")
  createdAt           DateTime    @default(now()) @map("created_at")

  actor            User?                @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  project          AnnotationProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspace        AnnotationWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  annotationVersion AnnotationVersion?  @relation(fields: [annotationVersionId], references: [id], onDelete: SetNull)
  projectVersion   ProjectVersion?      @relation(fields: [projectVersionId], references: [id], onDelete: SetNull)
  file             FileObject?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  job              ProcessingJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([projectId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Operation 永远属于可编辑工作区；不可变版本只引用 snapshot，不接收后续 operation。
model AnnotationOperation {
  id             String                    @id @default(uuid())
  workspaceId    String                    @map("workspace_id")
  actorUserId    String                    @map("actor_user_id")
  baseRevision   Int                       @map("base_revision")
  localRevision  Int?                      @map("local_revision")
  serverRevision Int?                      @map("server_revision")
  action         String
  payload        Json
  status         AnnotationOperationStatus @default(accepted)
  createdAt      DateTime                  @default(now()) @map("created_at")

  workspace AnnotationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User                @relation("AnnotationOperationActor", fields: [actorUserId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@map("annotation_operations")
}
