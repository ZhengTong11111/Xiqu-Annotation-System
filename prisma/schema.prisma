generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  super_admin
  admin
  teacher
  annotator
  reviewer
  service
}

enum ResourceType {
  folder
  project
  annotation_file
  media_file
}

enum MediaSourceType {
  uploaded
  aliyun_vod
}

enum MediaKind {
  video
  audio
}

enum MediaAudioTrackKind {
  original
  vocal
  accompaniment
  denoised
  reference
  custom
}

enum ResourceCapability {
  read
  write
  review
  create_child
  copy
  move
  delete
  download
  manage_permissions
}

// 文件工作流只描述平台治理阶段，不进入标注 payload 或 annotation revision。
enum AnnotationWorkflowStatus {
  unannotated
  annotated
  reviewed
}

// 项目职责组表达人员分工，不替代逐资源 ACL。
enum ProjectWorkflowGroup {
  annotation
  review
}

enum ProcessingJobType {
  pitch_extraction
  spectrogram_generation
  staff_notation_render
  gongche_render
  pose_estimation
  video_transcode
  audio_extract
  annotation_export
  media_analysis
  force_alignment
}

enum ProcessingJobStatus {
  queued
  running
  cancelling
  cancelled
  succeeded
  failed
}

enum ProcessingJobCancellationMode {
  user_request
  admin_force
}

enum ProcessingJobCommandAction {
  cancel_request
  force_cancel
  retry
}

enum ProcessingJobCommandOutcome {
  pending
  request_cancelled_execution_continues
  execution_cancelling
  execution_cancelled
  already_terminal
  request_already_cancelled
  retry_scheduled
}

enum MediaAnalysisAssetKind {
  waveform
  spectrogram
  pitch
}

enum AlignmentArtifactKind {
  prediction
}

enum AlignmentQualityAssessmentScope {
  editor
  reviewer
}

enum AlignmentQualityVerdict {
  correct
  needs_adjustment
  unusable
}

enum AlignmentQualityIssueCode {
  lyric_mismatch
  missing_character
  duplicate_character
  filler_character
  overlapping_voices
  unclear_audio
  audio_desync
  source_separation_artifact
  boundary_offset
  other
}

// 训练切分使用稳定研究身份；显示名只供管理界面辨认，绝不能替代 UUID 参与分组。
enum AlignmentResearchGroupKind {
  work
  performer
}

enum AlignmentTrainingTargetMode {
  prediction
  manual_revision
}

enum AlignmentTrainingSplit {
  train
  validation
  test
}

enum AuditAction {
  auth_login
  account_create
  account_update
  account_password_reset
  account_password_change
  file_upload
  media_upload
  aliyun_vod_media_create
  resource_create
  resource_update
  resource_copy
  resource_move
  resource_trash
  resource_restore
  resource_delete
  annotation_file_save
  alignment_quality_assessment_upsert
  alignment_research_group_create
  project_alignment_research_groups_update
  alignment_training_export_freeze
  annotation_workflow_status_update
  project_workflow_groups_update
  annotation_client_sync_failure
  annotation_mutation_lease_acquire
  annotation_mutation_lease_renew
  annotation_mutation_lease_release
  annotation_snapshot_restore
  annotation_confirmation_create
  annotation_confirmation_revoke
  annotation_range_comment_create
  annotation_range_comment_withdraw
  annotation_range_feedback_create
  annotation_range_feedback_withdraw
  annotation_review_link_create
  annotation_review_link_revoke
  resource_permission_upsert
  resource_permission_remove
  resource_inheritance_update
  annotation_media_bind
  annotation_media_unbind
  annotation_analysis_audio_update
  media_audio_track_create
  media_audio_track_update
  media_audio_track_delete
  media_audio_track_reorder
  annotation_audio_preference_update
  media_analysis_migration_apply
  analysis_audio_setting_migration_apply
  media_analysis_create
  processing_job_request_cancel
  processing_job_force_cancel
  processing_job_retry
  job_create
  permission_denied
  storage_orphan_cleanup
  maintenance_enable
  maintenance_disable
}

enum AnnotationConfirmationTargetMode {
  all
  domains
  tracks
}

enum AnnotationConfirmationDomain {
  subtitle_lines
  character_annotations
  gongche_annotations
  banyan_sections
  banyan_marks
  custom_tracks
  custom_blocks
  attached_points
}

enum AnnotationOperationStatus {
  accepted
  rejected
  superseded
}

enum AnnotationToolEventName {
  sentence_character_even_timing_reset
}

enum AnnotationToolAttemptEntryPoint {
  sentence_list
  timeline_context_menu
}

enum AnnotationToolAttemptOutcome {
  cancelled
  no_change
  blocked
  failed
  committed
}

enum AnnotationMutationPurpose {
  track_structure
  bulk_import
  bulk_repair
}

model User {
  id           String   @id @default(uuid())
  accountName  String   @unique @map("account_name")
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                             UserRole[]
  sessions                          Session[]
  ownedFiles                        FileObject[]                      @relation("FileOwner")
  ownedResources                    ResourceEntry[]                   @relation("ResourceOwner")
  resourcePermissions               ResourcePermission[]              @relation("PermissionSubject")
  grantedResourcePermissions        ResourcePermission[]              @relation("PermissionGrantor")
  resourceStates                    ResourceUserState[]
  editedAnnotationFiles             AnnotationFile[]                  @relation("AnnotationLastEditor")
  updatedAnnotationWorkflows        AnnotationFile[]                  @relation("AnnotationWorkflowUpdater")
  projectWorkflowMemberships        ProjectWorkflowMember[]           @relation("ProjectWorkflowMemberUser")
  assignedProjectWorkflowMembers    ProjectWorkflowMember[]           @relation("ProjectWorkflowMemberAssigner")
  recoverySnapshots                 AnnotationRecoverySnapshot[]      @relation("RecoverySnapshotCreator")
  createdConfirmations              AnnotationConfirmation[]          @relation("AnnotationConfirmationCreator")
  revokedConfirmations              AnnotationConfirmation[]          @relation("AnnotationConfirmationRevoker")
  createdRangeComments              AnnotationRangeComment[]          @relation("AnnotationRangeCommentCreator")
  withdrawnRangeComments            AnnotationRangeComment[]          @relation("AnnotationRangeCommentWithdrawer")
  createdAnnotationReviewLinks      AnnotationReviewLink[]             @relation("AnnotationReviewLinkCreator")
  revokedAnnotationReviewLinks      AnnotationReviewLink[]             @relation("AnnotationReviewLinkRevoker")
  jobs                              ProcessingJob[]                   @relation("JobCreator")
  processingJobRequests             ProcessingJobRequest[]            @relation("ProcessingJobRequester")
  processingJobRequestKeys          ProcessingJobRequestKey[]         @relation("ProcessingJobRequestKeyOwner")
  processingJobCancellationRequests ProcessingJob[]                   @relation("ProcessingJobCanceller")
  cancelledProcessingJobRequests    ProcessingJobRequest[]            @relation("ProcessingJobRequestCanceller")
  processingJobCommands             ProcessingJobCommand[]            @relation("ProcessingJobCommandActor")
  createdMediaAudioTracks           MediaAudioTrack[]                 @relation("MediaAudioTrackCreator")
  updatedAnnotationAudioPreferences AnnotationAudioPreference[]       @relation("AnnotationAudioPreferenceUpdater")
  createdMediaAnalysisRuns          MediaAnalysisRun[]                @relation("MediaAnalysisRunCreator")
  supersededMediaAnalysisRuns       MediaAnalysisRun[]                @relation("MediaAnalysisRunSuperseder")
  createdAlignmentRuns              AlignmentRun[]                    @relation("AlignmentRunCreator")
  alignmentApplications             AlignmentApplication[]            @relation("AlignmentApplicationActor")
  alignmentQualityAssessments       AlignmentQualityAssessment[]      @relation("AlignmentQualityAssessmentActor")
  createdAlignmentResearchGroups    AlignmentResearchGroup[]          @relation("AlignmentResearchGroupCreator")
  assignedAlignmentResearchGroups   ProjectAlignmentResearchGroup[]   @relation("ProjectAlignmentResearchGroupAssigner")
  createdAlignmentTrainingExports   AlignmentTrainingExport[]         @relation("AlignmentTrainingExportCreator")
  auditLogs                         AuditLog[]                        @relation("AuditActor")
  annotationOperations              AnnotationOperation[]             @relation("AnnotationOperationActor")
  annotationToolAttempts            AnnotationToolAttempt[]           @relation("AnnotationToolAttemptActor")
  annotationMutationLeases          AnnotationMutationLease[]         @relation("AnnotationMutationLeaseHolder")
  annotationCollaborationTickets    AnnotationCollaborationTicket[]   @relation("AnnotationCollaborationTicketUser")
  annotationCollaborationPresences  AnnotationCollaborationPresence[] @relation("AnnotationCollaborationPresenceUser")

  @@map("users")
}

model UserRole {
  id     String       @id @default(uuid())
  userId String       @map("user_id")
  role   PlatformRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// FileObject 只负责对象存储中的二进制实体；目录层级和权限统一由 ResourceEntry 管理。
model FileObject {
  id          String   @id @default(uuid())
  name        String
  mimeType    String   @map("mime_type")
  // size 使用 BigInt 以支持超过 2 GiB 的单文件；线格式仍为 JSON number，在 mapper 边界转换。
  size        BigInt
  storageKey  String   @unique @map("storage_key")
  checksum    String?
  ownerUserId String   @map("owner_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  owner      User        @relation("FileOwner", fields: [ownerUserId], references: [id])
  mediaFiles MediaFile[]
  auditLogs  AuditLog[]

  @@index([ownerUserId])
  @@map("files")
}

// 所有可见对象共用一棵资源树。project 是具有额外元数据的特殊文件夹。
model ResourceEntry {
  id                         String       @id @default(uuid())
  parentId                   String?      @map("parent_id")
  type                       ResourceType
  name                       String
  ownerUserId                String       @map("owner_user_id")
  breakPermissionInheritance Boolean      @default(false) @map("break_permission_inheritance")
  archivedAt                 DateTime?    @map("archived_at")
  trashedAt                  DateTime?    @map("trashed_at")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  parent                  ResourceEntry?                  @relation("ResourceTree", fields: [parentId], references: [id], onDelete: Cascade)
  children                ResourceEntry[]                 @relation("ResourceTree")
  owner                   User                            @relation("ResourceOwner", fields: [ownerUserId], references: [id])
  projectMetadata         ProjectMetadata?
  projectWorkflowMembers  ProjectWorkflowMember[]
  alignmentResearchGroups ProjectAlignmentResearchGroup[]
  annotationFile          AnnotationFile?
  mediaFile               MediaFile?
  permissions             ResourcePermission[]
  userStates              ResourceUserState[]
  processingJobs          ProcessingJob[]
  processingJobRequests   ProcessingJobRequest[]
  auditLogs               AuditLog[]

  @@index([parentId, type])
  @@index([parentId, trashedAt, archivedAt, name, id], map: "resource_entries_directory_name_idx")
  @@index([parentId, trashedAt, archivedAt, updatedAt, id], map: "resource_entries_directory_updated_idx")
  @@index([ownerUserId])
  @@index([trashedAt])
  @@map("resource_entries")
}

model ProjectMetadata {
  resourceId            String  @id @map("resource_id")
  description           String?
  researchGroupRevision Int     @default(0) @map("research_group_revision")

  resource ResourceEntry @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("project_metadata")
}

// 全局研究分组 identity 可被多个项目复用；同名不自动合并，避免同名剧目或演员被误判为同一实体。
model AlignmentResearchGroup {
  id          String                     @id
  kind        AlignmentResearchGroupKind
  displayName String                     @map("display_name")
  createdBy   String                     @map("created_by")
  createdAt   DateTime                   @default(now()) @map("created_at")

  creator      User                            @relation("AlignmentResearchGroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  projectLinks ProjectAlignmentResearchGroup[]

  @@index([kind, displayName, id])
  @@index([createdBy])
  @@map("alignment_research_groups")
}

// 项目关系和普通 ACL/职责组互相独立；完整集合替换只改这张关系表和 project revision。
model ProjectAlignmentResearchGroup {
  projectResourceId String   @map("project_resource_id")
  researchGroupId   String   @map("research_group_id")
  assignedBy        String   @map("assigned_by")
  assignedAt        DateTime @default(now()) @map("assigned_at")

  project  ResourceEntry          @relation(fields: [projectResourceId], references: [id], onDelete: Cascade)
  group    AlignmentResearchGroup @relation(fields: [researchGroupId], references: [id], onDelete: Restrict)
  assigner User                   @relation("ProjectAlignmentResearchGroupAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([projectResourceId, researchGroupId])
  @@index([researchGroupId])
  @@index([assignedBy])
  @@map("project_alignment_research_groups")
}

// 项目职责组成员关系是独立的有效权限来源；手工 ResourcePermission 始终单独保存、单独撤销。
model ProjectWorkflowMember {
  id                String               @id @default(uuid())
  projectResourceId String               @map("project_resource_id")
  userId            String               @map("user_id")
  group             ProjectWorkflowGroup
  createdBy         String               @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")

  project  ResourceEntry @relation(fields: [projectResourceId], references: [id], onDelete: Cascade)
  user     User          @relation("ProjectWorkflowMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner User          @relation("ProjectWorkflowMemberAssigner", fields: [createdBy], references: [id])

  @@unique([projectResourceId, userId, group])
  @@index([projectResourceId, group])
  @@index([userId, group])
  @@map("project_workflow_members")
}

model AnnotationFile {
  resourceId            String                   @id @map("resource_id")
  payload               Json
  revision              Int                      @default(1)
  mediaResourceId       String?                  @map("media_resource_id")
  lastEditedBy          String                   @map("last_edited_by")
  lastSavedAt           DateTime                 @default(now()) @map("last_saved_at")
  lastOperationSequence Int                      @default(0) @map("last_operation_sequence")
  workflowStatus        AnnotationWorkflowStatus @default(unannotated) @map("workflow_status")
  workflowUpdatedAt     DateTime?                @map("workflow_updated_at")
  workflowUpdatedBy     String?                  @map("workflow_updated_by")

  resource               ResourceEntry                     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  mediaResource          MediaFile?                        @relation("AnnotationMediaResource", fields: [mediaResourceId], references: [resourceId], onDelete: SetNull)
  lastEditor             User                              @relation("AnnotationLastEditor", fields: [lastEditedBy], references: [id])
  workflowUpdater        User?                             @relation("AnnotationWorkflowUpdater", fields: [workflowUpdatedBy], references: [id], onDelete: SetNull)
  recoverySnapshots      AnnotationRecoverySnapshot[]
  confirmations          AnnotationConfirmation[]
  rangeComments          AnnotationRangeComment[]
  targetReviewLinks      AnnotationReviewLink[]             @relation("AnnotationReviewLinkTarget")
  sourceReviewLinks      AnnotationReviewLink[]             @relation("AnnotationReviewLinkSource")
  operations             AnnotationOperation[]
  toolAttempts           AnnotationToolAttempt[]
  mutationLease          AnnotationMutationLease?
  collaborationTickets   AnnotationCollaborationTicket[]
  collaborationPresences AnnotationCollaborationPresence[]
  audioPreference        AnnotationAudioPreference?
  alignmentRuns          AlignmentRun[]
  alignmentApplications  AlignmentApplication[]

  @@index([mediaResourceId])
  @@index([lastEditedBy])
  @@index([workflowStatus])
  @@index([workflowUpdatedBy])
  @@map("annotation_files")
}

// 大范围结构变更使用数据库租约跨 API 实例互斥；明文 token 只返回客户端，数据库仅保存摘要。
model AnnotationMutationLease {
  annotationFileId String                    @id @map("annotation_file_id")
  holderUserId     String                    @map("holder_user_id")
  tokenHash        String                    @unique @map("token_hash")
  purpose          AnnotationMutationPurpose
  baseRevision     Int                       @map("base_revision")
  createdAt        DateTime                  @default(now()) @map("created_at")
  expiresAt        DateTime                  @map("expires_at")

  annotationFile AnnotationFile @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  holder         User           @relation("AnnotationMutationLeaseHolder", fields: [holderUserId], references: [id], onDelete: Cascade)

  @@index([holderUserId])
  @@index([expiresAt])
  @@map("annotation_mutation_leases")
}

// WebSocket 连接只接受短时一次性票据；数据库保存摘要，避免平台访问令牌进入 upgrade URL。
model AnnotationCollaborationTicket {
  id               String    @id @default(uuid())
  tokenHash        String    @unique @map("token_hash")
  annotationFileId String    @map("annotation_file_id")
  userId           String    @map("user_id")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  annotationFile AnnotationFile @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  user           User           @relation("AnnotationCollaborationTicketUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([annotationFileId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("annotation_collaboration_tickets")
}

// Presence 只保存短生命周期在线事实，不属于标注 payload、恢复快照、operation 或审计历史。
model AnnotationCollaborationPresence {
  id               String   @id @default(uuid())
  annotationFileId String   @map("annotation_file_id")
  userId           String   @map("user_id")
  connectedAt      DateTime @default(now()) @map("connected_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  expiresAt        DateTime @map("expires_at")

  annotationFile AnnotationFile @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  user           User           @relation("AnnotationCollaborationPresenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([annotationFileId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("annotation_collaboration_presences")
}

// 确认记录保存独立研究审核事实；撤销只补充字段，不删除原始确认。
model AnnotationConfirmation {
  id                String                           @id @default(uuid())
  annotationFileId  String                           @map("annotation_file_id")
  confirmedRevision Int                              @map("confirmed_revision")
  startTime         Float                            @map("start_time")
  endTime           Float                            @map("end_time")
  targetMode        AnnotationConfirmationTargetMode @map("target_mode")
  domains           AnnotationConfirmationDomain[]   @default([])
  trackIds          String[]                         @default([]) @map("track_ids")
  note              String?
  createdBy         String                           @map("created_by")
  createdAt         DateTime                         @default(now()) @map("created_at")
  revokedBy         String?                          @map("revoked_by")
  revokedAt         DateTime?                        @map("revoked_at")
  revokeReason      String?                          @map("revoke_reason")

  annotationFile AnnotationFile @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  creator        User           @relation("AnnotationConfirmationCreator", fields: [createdBy], references: [id])
  revoker        User?          @relation("AnnotationConfirmationRevoker", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([annotationFileId, createdAt])
  @@index([annotationFileId, createdAt, id])
  @@index([annotationFileId, confirmedRevision])
  @@index([createdBy])
  @@index([revokedBy])
  @@map("annotation_confirmations")
}

// 范围评论是独立审核事实，不表达确认，也不进入标注 payload 或 revision。
model AnnotationRangeComment {
  id                String                           @id @default(uuid())
  annotationFileId  String                           @map("annotation_file_id")
  commentedRevision Int                              @map("commented_revision")
  startTime         Float                            @map("start_time")
  endTime           Float                            @map("end_time")
  targetMode        AnnotationConfirmationTargetMode @map("target_mode")
  domains           AnnotationConfirmationDomain[]   @default([])
  trackIds          String[]                         @default([]) @map("track_ids")
  kind              AnnotationRangeCommentKind      @default(review_comment)
  body              String
  createdBy         String                           @map("created_by")
  createdAt         DateTime                         @default(now()) @map("created_at")
  withdrawnBy       String?                          @map("withdrawn_by")
  withdrawnAt       DateTime?                        @map("withdrawn_at")
  withdrawReason    String?                          @map("withdraw_reason")

  annotationFile AnnotationFile @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  creator        User           @relation("AnnotationRangeCommentCreator", fields: [createdBy], references: [id])
  withdrawer     User?          @relation("AnnotationRangeCommentWithdrawer", fields: [withdrawnBy], references: [id], onDelete: Restrict)

  @@index([annotationFileId, createdAt, id])
  @@index([annotationFileId, commentedRevision])
  @@index([createdBy])
  @@index([withdrawnBy])
  @@map("annotation_range_comments")
}

// 重新链接只保存来源审核包的不可变快照和目标关系；它不复制或移动两张原生审核事实表。
model AnnotationReviewLink {
  id                       String   @id @default(uuid())
  targetAnnotationFileId   String   @map("target_annotation_file_id")
  sourceAnnotationFileId   String?  @map("source_annotation_file_id")
  sourceResourceIdSnapshot String   @map("source_resource_id_snapshot")
  sourceFileNameSnapshot   String   @map("source_file_name_snapshot")
  sourceRevision           Int      @map("source_revision")
  packageFingerprint       String   @map("package_fingerprint")
  packagePayload           Json     @map("package_payload")
  confirmationCount        Int      @map("confirmation_count")
  rangeRecordCount         Int      @map("range_record_count")
  createdBy                String   @map("created_by")
  createdAt                DateTime @default(now()) @map("created_at")
  revokedBy                String?  @map("revoked_by")
  revokedAt                DateTime? @map("revoked_at")
  revokeReason             String?  @map("revoke_reason")

  targetAnnotationFile AnnotationFile @relation("AnnotationReviewLinkTarget", fields: [targetAnnotationFileId], references: [resourceId], onDelete: Cascade)
  sourceAnnotationFile AnnotationFile? @relation("AnnotationReviewLinkSource", fields: [sourceAnnotationFileId], references: [resourceId], onDelete: SetNull)
  creator             User           @relation("AnnotationReviewLinkCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  revoker             User?          @relation("AnnotationReviewLinkRevoker", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@unique([targetAnnotationFileId, packageFingerprint])
  @@index([targetAnnotationFileId, createdAt, id])
  @@index([sourceAnnotationFileId])
  @@index([createdBy])
  @@index([revokedBy])
  @@map("annotation_review_links")
}

// 同一张追加式范围事实表承载审核评论和编辑反馈；kind 决定创建/撤回权限与视觉语义。
enum AnnotationRangeCommentKind {
  review_comment
  editor_feedback
}

// 恢复快照先扩展存储形态合同；HC2a 只允许 inline，后续阶段经影子校验后才能启用其他形态。
enum AnnotationRecoverySnapshotStorageMode {
  inline
  reconstructible
  archived
}

// 恢复快照通过标注文件 Inspector 受控查看，但不是普通资源、Fork 或发布版本。
model AnnotationRecoverySnapshot {
  id                     String                                @id @default(uuid())
  annotationFileId       String                                @map("annotation_file_id")
  revision               Int
  payload                Json
  storageMode            AnnotationRecoverySnapshotStorageMode @default(inline) @map("storage_mode")
  payloadSha256          String?                               @map("payload_sha256")
  checkpointSnapshotId   String?                               @map("checkpoint_snapshot_id")
  operationRevisionStart Int?                                  @map("operation_revision_start")
  operationRevisionEnd   Int?                                  @map("operation_revision_end")
  operationSequenceStart Int?                                  @map("operation_sequence_start")
  operationSequenceEnd   Int?                                  @map("operation_sequence_end")
  operationCount         Int?                                  @map("operation_count")
  compactionVersion      Int?                                  @map("compaction_version")
  compactedAt            DateTime?                             @map("compacted_at")
  createdBy              String                                @map("created_by")
  reason                 String?
  createdAt              DateTime                              @default(now()) @map("created_at")

  annotationFile AnnotationFile @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  creator        User           @relation("RecoverySnapshotCreator", fields: [createdBy], references: [id])

  @@unique([annotationFileId, revision])
  @@index([createdBy])
  @@map("annotation_recovery_snapshots")
}

model MediaFile {
  resourceId       String          @id @map("resource_id")
  sourceType       MediaSourceType @default(uploaded) @map("source_type")
  mediaKind        MediaKind       @map("media_kind")
  fileId           String?         @map("file_id")
  mimeType         String?         @map("mime_type")
  // uploaded 的 size 与 FileObject.size 一致使用 BigInt；VOD 不伪造本平台对象大小。
  size             BigInt?
  duration         Float?
  aliyunVodVideoId String?         @map("aliyun_vod_video_id")
  aliyunVodRegion  String?         @map("aliyun_vod_region")

  resource                ResourceEntry      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  file                    FileObject?        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  linkedAnnotationFiles   AnnotationFile[]   @relation("AnnotationMediaResource")
  mediaAnalysisRuns       MediaAnalysisRun[] @relation("MediaAnalysisSource")
  primaryAudioTracks      MediaAudioTrack[]  @relation("PrimaryMediaAudioTracks")
  audioTrackSources       MediaAudioTrack[]  @relation("AudioTrackSourceMedia")
  vodRenditionAudioTracks MediaAudioTrack[]  @relation("VodRenditionAudioTrackSource")
  alignmentRuns           AlignmentRun[]     @relation("AlignmentRunSourceMedia")

  @@index([fileId])
  @@index([sourceType])
  @@index([aliyunVodRegion, aliyunVodVideoId])
  @@map("media_files")
}

// 音轨关系属于主媒体平台元数据；偏移只负责把音频源时间映射到项目时间，不进入分析 run。
model MediaAudioTrack {
  id                          String              @id @default(uuid())
  primaryMediaResourceId      String              @map("primary_media_resource_id")
  audioMediaResourceId        String?             @map("audio_media_resource_id")
  vodRenditionMediaResourceId String?             @map("vod_rendition_media_resource_id")
  vodRenditionJobId           String?             @map("vod_rendition_job_id")
  vodRenditionFormat          String?             @map("vod_rendition_format")
  vodRenditionDefinition      String?             @map("vod_rendition_definition")
  vodRenditionBitrate         Float?              @map("vod_rendition_bitrate")
  vodRenditionDuration        Float?              @map("vod_rendition_duration")
  name                        String
  kind                        MediaAudioTrackKind
  offsetSeconds               Float               @default(0) @map("offset_seconds")
  sortOrder                   Int                 @map("sort_order")
  enabled                     Boolean             @default(true)
  createdBy                   String              @map("created_by")
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")

  primaryMedia          MediaFile                   @relation("PrimaryMediaAudioTracks", fields: [primaryMediaResourceId], references: [resourceId], onDelete: Cascade)
  audioMedia            MediaFile?                  @relation("AudioTrackSourceMedia", fields: [audioMediaResourceId], references: [resourceId], onDelete: Restrict)
  vodRenditionMedia     MediaFile?                  @relation("VodRenditionAudioTrackSource", fields: [vodRenditionMediaResourceId], references: [resourceId], onDelete: Restrict)
  creator               User                        @relation("MediaAudioTrackCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  defaultForAnnotations AnnotationAudioPreference[]
  processingJobRequests ProcessingJobRequest[]
  alignmentRuns         AlignmentRun[]

  @@unique([primaryMediaResourceId, audioMediaResourceId])
  @@index([primaryMediaResourceId, sortOrder, id])
  @@index([audioMediaResourceId])
  @@index([vodRenditionMediaResourceId])
  @@index([createdBy])
  @@map("media_audio_tracks")
}

// 默认监听音轨是标注文件的平台偏好，不进入 ProjectData、revision、撤销栈或协作命令。
model AnnotationAudioPreference {
  annotationFileId    String   @id @map("annotation_file_id")
  defaultAudioTrackId String?  @map("default_audio_track_id")
  updatedBy           String   @map("updated_by")
  updatedAt           DateTime @updatedAt @map("updated_at")

  annotationFile AnnotationFile   @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  defaultTrack   MediaAudioTrack? @relation(fields: [defaultAudioTrackId], references: [id], onDelete: SetNull)
  updater        User             @relation("AnnotationAudioPreferenceUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([defaultAudioTrackId])
  @@index([updatedBy])
  @@map("annotation_audio_preferences")
}

// 分析 run 只归属于媒体内容；音轨偏移在每次请求时从关系表读取，不固化进共享 run。
model MediaAnalysisRun {
  id                      String              @id @default(uuid())
  sourceMediaResourceId   String              @map("source_media_resource_id")
  sourceFingerprint       String              @map("source_fingerprint")
  mediaFingerprint        String?             @map("media_fingerprint")
  // VOD rendition 的 JobId 是稳定流身份；临时播放 URL 绝不能进入分析 run。
  sourceVodRenditionJobId String?             @map("source_vod_rendition_job_id")
  algorithmVersion        String              @map("algorithm_version")
  configHash              String              @map("config_hash")
  config                  Json
  status                  ProcessingJobStatus @default(queued)
  progress                Float               @default(0)
  errorCode               String?             @map("error_code")
  duration                Float?
  sampleRate              Int?                @map("sample_rate")
  manifest                Json?
  createdBy               String              @map("created_by")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  completedAt             DateTime?           @map("completed_at")
  supersededByRunId       String?             @map("superseded_by_run_id")
  supersededAt            DateTime?           @map("superseded_at")
  supersededBy            String?             @map("superseded_by")

  sourceMedia    MediaFile            @relation("MediaAnalysisSource", fields: [sourceMediaResourceId], references: [resourceId], onDelete: Cascade)
  creator        User                 @relation("MediaAnalysisRunCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  superseder     User?                @relation("MediaAnalysisRunSuperseder", fields: [supersededBy], references: [id], onDelete: Restrict)
  canonicalRun   MediaAnalysisRun?    @relation("MediaAnalysisRunSupersession", fields: [supersededByRunId], references: [id], onDelete: Restrict)
  supersededRuns MediaAnalysisRun[]   @relation("MediaAnalysisRunSupersession")
  assets         MediaAnalysisAsset[]
  jobs           ProcessingJob[]
  alignmentRuns  AlignmentRun[]       @relation("AlignmentRunMediaAnalysis")

  @@index([sourceMediaResourceId])
  @@index([sourceMediaResourceId, sourceFingerprint, algorithmVersion, configHash])
  @@index([sourceMediaResourceId, mediaFingerprint, algorithmVersion, configHash])
  @@index([sourceMediaResourceId, sourceVodRenditionJobId])
  @@index([supersededByRunId])
  @@index([supersededBy])
  @@index([status])
  @@map("media_analysis_runs")
}

// 大型分析结果按种类、预设、层级和时间瓦片保存；公开 API 只暴露 asset id，不暴露 storageKey。
model MediaAnalysisAsset {
  id         String                 @id @default(uuid())
  runId      String                 @map("run_id")
  kind       MediaAnalysisAssetKind
  preset     String
  level      Int                    @default(0)
  tileIndex  Int                    @map("tile_index")
  startTime  Float                  @map("start_time")
  endTime    Float                  @map("end_time")
  mimeType   String                 @map("mime_type")
  size       BigInt
  checksum   String
  storageKey String                 @unique @map("storage_key")
  createdAt  DateTime               @default(now()) @map("created_at")

  run MediaAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, kind, preset, level, tileIndex])
  @@index([runId, kind, preset, level, startTime])
  @@map("media_analysis_assets")
}

// 对齐 run 固化模型输入身份；来源实体删除时外键可空，但 snapshot id/hash 永久保留研究溯源。
model AlignmentRun {
  id                            String              @id @default(uuid())
  annotationFileId              String?             @map("annotation_file_id")
  annotationFileIdSnapshot      String              @map("annotation_file_id_snapshot")
  inputRevision                 Int                 @map("input_revision")
  inputTextFingerprint          String              @map("input_text_fingerprint")
  inputSentenceCount            Int                 @map("input_sentence_count")
  inputCharacterCount           Int                 @map("input_character_count")
  sourceMediaResourceId         String?             @map("source_media_resource_id")
  sourceMediaResourceIdSnapshot String              @map("source_media_resource_id_snapshot")
  sourceFingerprint             String              @map("source_fingerprint")
  mediaAudioTrackId             String?             @map("media_audio_track_id")
  mediaAudioTrackIdSnapshot     String              @map("media_audio_track_id_snapshot")
  audioOffsetMicros             BigInt              @map("audio_offset_micros")
  mediaAnalysisRunId            String?             @map("media_analysis_run_id")
  mediaAnalysisFingerprint      String?             @map("media_analysis_fingerprint")
  modelName                     String              @map("model_name")
  modelVersion                  String              @map("model_version")
  dictionaryVersion             String              @map("dictionary_version")
  codeVersion                   String              @map("code_version")
  configHash                    String              @map("config_hash")
  config                        Json
  identityHash                  String              @unique @map("identity_hash")
  status                        ProcessingJobStatus @default(queued)
  progress                      Float               @default(0)
  errorCode                     String?             @map("error_code")
  manifest                      Json?
  createdBy                     String              @map("created_by")
  createdAt                     DateTime            @default(now()) @map("created_at")
  updatedAt                     DateTime            @updatedAt @map("updated_at")
  completedAt                   DateTime?           @map("completed_at")

  annotationFile  AnnotationFile?   @relation(fields: [annotationFileId], references: [resourceId], onDelete: SetNull)
  sourceMedia     MediaFile?        @relation("AlignmentRunSourceMedia", fields: [sourceMediaResourceId], references: [resourceId], onDelete: SetNull)
  mediaAudioTrack MediaAudioTrack?  @relation(fields: [mediaAudioTrackId], references: [id], onDelete: SetNull)
  mediaAnalysisRun MediaAnalysisRun? @relation("AlignmentRunMediaAnalysis", fields: [mediaAnalysisRunId], references: [id], onDelete: SetNull)
  creator         User              @relation("AlignmentRunCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  artifacts       AlignmentArtifact[]
  jobs            ProcessingJob[]
  applications    AlignmentApplication[]

  @@index([annotationFileId, inputRevision])
  @@index([sourceMediaResourceId])
  @@index([mediaAudioTrackId])
  @@index([mediaAnalysisRunId])
  @@index([status, createdAt])
  @@index([createdBy, createdAt])
  @@map("alignment_runs")
}

// 大型预测正文只存在对象存储；数据库仅保存固定格式和完整性元数据。
model AlignmentArtifact {
  id            String                @id @default(uuid())
  runId         String                @map("run_id")
  kind          AlignmentArtifactKind
  formatVersion Int                   @map("format_version")
  mimeType      String                @map("mime_type")
  size          BigInt
  checksum      String
  storageKey    String                @unique @map("storage_key")
  createdAt     DateTime              @default(now()) @map("created_at")

  run          AlignmentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  applications AlignmentApplication[]

  @@unique([runId, kind])
  @@index([runId, createdAt])
  @@map("alignment_artifacts")
}

// 一次结果应用只保存轻量溯源；逐字 before/after 继续由真实 annotation operation 承载。
model AlignmentApplication {
  id                    String   @id @default(uuid())
  alignmentRunId        String   @map("alignment_run_id")
  alignmentArtifactId   String   @map("alignment_artifact_id")
  annotationFileId      String   @map("annotation_file_id")
  actorUserId           String   @map("actor_user_id")
  clientActionId        String   @map("client_action_id")
  requestHash           String   @map("request_hash")
  baseRevision          Int      @map("base_revision")
  committedRevision     Int      @map("committed_revision")
  operationCount        Int      @map("operation_count")
  appliedCharacterCount Int      @map("applied_character_count")
  createdAt             DateTime @default(now()) @map("created_at")

  run            AlignmentRun         @relation(fields: [alignmentRunId], references: [id], onDelete: Restrict)
  artifact       AlignmentArtifact    @relation(fields: [alignmentArtifactId], references: [id], onDelete: Restrict)
  annotationFile AnnotationFile        @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  actor          User                  @relation("AlignmentApplicationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  operations     AnnotationOperation[]
  qualityAssessments AlignmentQualityAssessment[]

  @@unique([annotationFileId, actorUserId, clientActionId])
  @@index([alignmentRunId, createdAt])
  @@index([alignmentArtifactId])
  @@index([annotationFileId, committedRevision])
  @@index([actorUserId, createdAt])
  @@map("alignment_applications")
}

// 质量评价采用追加历史 + 单一当前行；不复制正文、预测或 operation before/after。
model AlignmentQualityAssessment {
  id                     String                          @id @default(uuid())
  alignmentApplicationId String                          @map("alignment_application_id")
  assessorUserId         String                          @map("assessor_user_id")
  clientActionId         String                          @map("client_action_id")
  requestHash            String                          @map("request_hash")
  scope                   AlignmentQualityAssessmentScope
  verdict                 AlignmentQualityVerdict
  issueCodes              AlignmentQualityIssueCode[]     @map("issue_codes")
  supersededAt            DateTime?                       @map("superseded_at")
  createdAt               DateTime                        @default(now()) @map("created_at")

  application AlignmentApplication @relation(fields: [alignmentApplicationId], references: [id], onDelete: Cascade)
  assessor    User                 @relation("AlignmentQualityAssessmentActor", fields: [assessorUserId], references: [id], onDelete: Restrict)

  @@unique([assessorUserId, clientActionId])
  @@index([alignmentApplicationId, createdAt])
  @@index([alignmentApplicationId, assessorUserId, scope, supersededAt])
  @@index([assessorUserId, createdAt])
  @@map("alignment_quality_assessments")
}

// 训练导出先冻结轻量 provenance；大型 prediction/audio 对象由后续后台任务按这些稳定引用解析。
model AlignmentTrainingExport {
  id               String   @id @default(uuid())
  createdBy        String   @map("created_by")
  clientActionId   String   @map("client_action_id")
  requestHash      String   @map("request_hash")
  manifestFormat   String   @map("manifest_format")
  manifestVersion  Int      @map("manifest_version")
  manifestChecksum String   @map("manifest_checksum")
  manifest         Json
  splitSeedHash    String   @map("split_seed_hash")
  splitRatios      Json     @map("split_ratios")
  splitCounts      Json     @map("split_counts")
  sampleCount      Int      @map("sample_count")
  componentCount   Int      @map("component_count")
  createdAt        DateTime @default(now()) @map("created_at")

  creator User                          @relation("AlignmentTrainingExportCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  items   AlignmentTrainingExportItem[]

  @@unique([createdBy, clientActionId])
  @@index([createdAt, id])
  @@index([manifestChecksum])
  @@map("alignment_training_exports")
}

// 每项保存严格 manifest item 和关联 revision；不以 FK 追随未来可变 application/project 生命周期。
model AlignmentTrainingExportItem {
  exportId                     String                      @map("export_id")
  alignmentApplicationId       String                      @map("alignment_application_id")
  annotationFileIdSnapshot     String                      @map("annotation_file_id_snapshot")
  projectResourceIdSnapshot    String                      @map("project_resource_id_snapshot")
  projectResearchGroupRevision Int                         @map("project_research_group_revision")
  alignmentRunId               String                      @map("alignment_run_id")
  alignmentArtifactId          String                      @map("alignment_artifact_id")
  baseRevision                 Int                         @map("base_revision")
  committedRevision            Int                         @map("committed_revision")
  observationEndRevision       Int                         @map("observation_end_revision")
  targetMode                   AlignmentTrainingTargetMode @map("target_mode")
  targetRevision               Int                         @map("target_revision")
  groupComponentHash           String                      @map("group_component_hash")
  split                        AlignmentTrainingSplit
  snapshot                     Json

  export AlignmentTrainingExport        @relation(fields: [exportId], references: [id], onDelete: Cascade)
  groups AlignmentTrainingExportGroup[]

  @@id([exportId, alignmentApplicationId])
  @@index([annotationFileIdSnapshot])
  @@index([projectResourceIdSnapshot])
  @@index([alignmentRunId])
  @@index([alignmentArtifactId])
  @@map("alignment_training_export_items")
}

// 分组快照保留冻结当时的稳定 identity 与有限显示名，不依赖后来可能解绑的项目关系。
model AlignmentTrainingExportGroup {
  exportId                  String                     @map("export_id")
  alignmentApplicationId    String                     @map("alignment_application_id")
  researchGroupId           String                     @map("research_group_id")
  projectResourceIdSnapshot String                     @map("project_resource_id_snapshot")
  kind                      AlignmentResearchGroupKind
  displayNameSnapshot       String                     @map("display_name_snapshot")

  item AlignmentTrainingExportItem @relation(fields: [exportId, alignmentApplicationId], references: [exportId, alignmentApplicationId], onDelete: Cascade)

  @@id([exportId, alignmentApplicationId, researchGroupId])
  @@index([researchGroupId])
  @@index([projectResourceIdSnapshot])
  @@map("alignment_training_export_groups")
}

// 不使用“拒绝”记录：有效权限由管理员/所有者特权、直接授权和未被截断的祖先授权合并得到。
model ResourcePermission {
  id                String               @id @default(uuid())
  resourceId        String               @map("resource_id")
  userId            String               @map("user_id")
  capabilities      ResourceCapability[]
  inheritToChildren Boolean              @default(true) @map("inherit_to_children")
  expiresAt         DateTime?            @map("expires_at")
  createdBy         String               @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  resource ResourceEntry @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User          @relation("PermissionSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantor  User          @relation("PermissionGrantor", fields: [createdBy], references: [id])

  @@unique([resourceId, userId])
  @@index([userId])
  @@map("resource_permissions")
}

model ResourceUserState {
  resourceId   String    @map("resource_id")
  userId       String    @map("user_id")
  favorite     Boolean   @default(false)
  lastOpenedAt DateTime? @map("last_opened_at")

  resource ResourceEntry @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([resourceId, userId])
  @@index([userId, favorite])
  @@index([userId, lastOpenedAt], map: "resource_user_states_recent_idx")
  @@map("resource_user_states")
}

model ProcessingJob {
  id                 String                         @id @default(uuid())
  type               ProcessingJobType
  status             ProcessingJobStatus            @default(queued)
  resourceId         String?                        @map("resource_id")
  inputFileIds       String[]                       @default([]) @map("input_file_ids")
  createdBy          String                         @map("created_by")
  progress           Float                          @default(0)
  errorMessage       String?                        @map("error_message")
  result             Json?
  analysisRunId      String?                        @map("analysis_run_id")
  alignmentRunId     String?                        @map("alignment_run_id")
  attemptCount       Int                            @default(0) @map("attempt_count")
  claimedBy          String?                        @map("claimed_by")
  claimedAt          DateTime?                      @map("claimed_at")
  heartbeatAt        DateTime?                      @map("heartbeat_at")
  finishedAt         DateTime?                      @map("finished_at")
  errorCode          String?                        @map("error_code")
  deduplicationKey   String                         @map("deduplication_key")
  cancelRequestedAt  DateTime?                      @map("cancel_requested_at")
  cancelRequestedBy  String?                        @map("cancel_requested_by")
  cancellationMode   ProcessingJobCancellationMode? @map("cancellation_mode")
  cancellationReason String?                        @map("cancellation_reason")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  resource              ResourceEntry?         @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  creator               User                   @relation("JobCreator", fields: [createdBy], references: [id])
  cancellationRequester User?                  @relation("ProcessingJobCanceller", fields: [cancelRequestedBy], references: [id], onDelete: Restrict)
  analysisRun           MediaAnalysisRun?      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  alignmentRun          AlignmentRun?          @relation(fields: [alignmentRunId], references: [id], onDelete: Cascade)
  requests              ProcessingJobRequest[]
  commands              ProcessingJobCommand[] @relation("ProcessingJobCommandTarget")
  retryResults          ProcessingJobCommand[] @relation("ProcessingJobCommandResult")

  @@index([resourceId])
  @@index([status])
  @@index([analysisRunId])
  @@index([alignmentRunId])
  @@index([deduplicationKey])
  @@index([cancelRequestedBy])
  @@index([status, createdAt])
  @@map("processing_jobs")
}

// 系统共享执行与账号需求必须分开保存；取消个人需求不能误伤其他账号仍在复用的计算。
model ProcessingJobRequest {
  id                 String    @id @default(uuid())
  jobId              String    @map("job_id")
  requesterUserId    String    @map("requester_user_id")
  contextResourceId  String?   @map("context_resource_id")
  mediaAudioTrackId  String?   @map("media_audio_track_id")
  requestedAt        DateTime  @default(now()) @map("requested_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledBy        String?   @map("cancelled_by")
  cancellationReason String?   @map("cancellation_reason")

  job             ProcessingJob             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requester       User                      @relation("ProcessingJobRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  // 历史任务不能阻止未来永久删除资源；资源消失后 request 仍保留，但不再公开资源详情。
  contextResource ResourceEntry?            @relation(fields: [contextResourceId], references: [id], onDelete: SetNull)
  mediaAudioTrack MediaAudioTrack?          @relation(fields: [mediaAudioTrackId], references: [id], onDelete: SetNull)
  canceller       User?                     @relation("ProcessingJobRequestCanceller", fields: [cancelledBy], references: [id], onDelete: Restrict)
  idempotencyKeys ProcessingJobRequestKey[]
  commands        ProcessingJobCommand[]

  @@unique([jobId, requesterUserId, contextResourceId])
  @@index([jobId, requestedAt])
  @@index([requesterUserId, requestedAt, id])
  @@index([contextResourceId, requestedAt, id])
  @@index([mediaAudioTrackId])
  @@index([cancelledBy])
  @@map("processing_job_requests")
}

// 一个账号的多标签页可以复用同一需求，但每个客户端请求编号仍必须永久绑定到不可变语义。
model ProcessingJobRequestKey {
  id                 String   @id @default(uuid())
  requestId          String   @map("request_id")
  requesterUserId    String   @map("requester_user_id")
  clientRequestId    String   @map("client_request_id")
  requestFingerprint String   @map("request_fingerprint")
  createdAt          DateTime @default(now()) @map("created_at")

  request   ProcessingJobRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requester User                 @relation("ProcessingJobRequestKeyOwner", fields: [requesterUserId], references: [id], onDelete: Restrict)

  @@unique([requesterUserId, clientRequestId])
  @@index([requestId, createdAt])
  @@map("processing_job_request_keys")
}

// 取消与重试命令独立保存幂等结果；网络响应丢失后不能再次改变 request/job 状态。
model ProcessingJobCommand {
  id                 String                      @id @default(uuid())
  actorUserId        String                      @map("actor_user_id")
  clientCommandId    String                      @map("client_command_id")
  action             ProcessingJobCommandAction
  requestFingerprint String                      @map("request_fingerprint")
  targetJobId        String?                     @map("target_job_id")
  targetRequestId    String?                     @map("target_request_id")
  resultJobId        String?                     @map("result_job_id")
  outcome            ProcessingJobCommandOutcome
  createdAt          DateTime                    @default(now()) @map("created_at")

  actor         User                  @relation("ProcessingJobCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetJob     ProcessingJob?        @relation("ProcessingJobCommandTarget", fields: [targetJobId], references: [id], onDelete: SetNull)
  targetRequest ProcessingJobRequest? @relation(fields: [targetRequestId], references: [id], onDelete: SetNull)
  resultJob     ProcessingJob?        @relation("ProcessingJobCommandResult", fields: [resultJobId], references: [id], onDelete: SetNull)

  @@unique([actorUserId, clientCommandId])
  @@index([targetJobId, createdAt])
  @@index([targetRequestId, createdAt])
  @@index([resultJobId])
  @@map("processing_job_commands")
}

model AuditLog {
  id           String      @id @default(uuid())
  action       AuditAction
  actorUserId  String?     @map("actor_user_id")
  resourceId   String?     @map("resource_id")
  fileId       String?     @map("file_id")
  targetUserId String?     @map("target_user_id")
  detail       Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  actor    User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  resource ResourceEntry? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  file     FileObject?    @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([action, createdAt, id])
  @@index([resourceId, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([targetUserId, createdAt, id])
  @@index([fileId, createdAt, id])
  @@map("audit_logs")
}

// 单行运行状态跨 API 实例持久化；维护锁本身由 PostgreSQL advisory lock 协调。
model PlatformRuntimeState {
  id                   String    @id
  maintenanceMode      Boolean   @default(false) @map("maintenance_mode")
  maintenanceReason    String?   @map("maintenance_reason")
  maintenanceStartedAt DateTime? @map("maintenance_started_at")
  maintenanceStartedBy String?   @map("maintenance_started_by")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("platform_runtime_state")
}

model AnnotationOperation {
  id                String                    @id @default(uuid())
  annotationFileId  String                    @map("annotation_file_id")
  actorUserId       String                    @map("actor_user_id")
  clientOperationId String                    @map("client_operation_id")
  requestHash       String                    @map("request_hash")
  sequence          Int
  baseRevision      Int                       @map("base_revision")
  localRevision     Int?                      @map("local_revision")
  action            String
  payload           Json
  status            AnnotationOperationStatus @default(accepted)
  committedRevision Int?                      @map("committed_revision")
  committedAt       DateTime?                 @map("committed_at")
  alignmentApplicationId String?              @map("alignment_application_id")
  createdAt         DateTime                  @default(now()) @map("created_at")

  annotationFile AnnotationFile @relation(fields: [annotationFileId], references: [resourceId], onDelete: Cascade)
  actor          User           @relation("AnnotationOperationActor", fields: [actorUserId], references: [id])
  toolAttempt    AnnotationToolAttempt?
  alignmentApplication AlignmentApplication? @relation(fields: [alignmentApplicationId], references: [id], onDelete: SetNull)

  @@unique([annotationFileId, sequence])
  @@unique([annotationFileId, actorUserId, clientOperationId])
  @@index([annotationFileId, createdAt])
  @@index([annotationFileId, committedRevision, sequence])
  @@index([actorUserId, createdAt])
  @@index([alignmentApplicationId, sequence])
  @@map("annotation_operations")
}

// 工具行为旁表只保存轻量生命周期与 operation 引用，绝不复制 ProjectData 或命令正文。
model AnnotationToolAttempt {
  id                    String                          @id
  eventName             AnnotationToolEventName        @map("event_name")
  actorUserId           String?                         @map("actor_user_id")
  annotationFileId      String?                         @map("annotation_file_id")
  sentenceId            String                          @map("sentence_id")
  entryPoint            AnnotationToolAttemptEntryPoint @map("entry_point")
  invokedAt             DateTime                        @map("invoked_at")
  confirmedAt           DateTime?                       @map("confirmed_at")
  finishedAt            DateTime?                       @map("finished_at")
  outcome               AnnotationToolAttemptOutcome?
  suppressPrompt        Boolean                         @default(false) @map("suppress_prompt")
  characterCount        Int                             @map("character_count")
  sentenceDurationMs    Int                             @map("sentence_duration_ms")
  annotationOperationId String?                         @unique @map("annotation_operation_id")
  committedRevision     Int?                            @map("committed_revision")
  details               Json?
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")

  actor              User?                @relation("AnnotationToolAttemptActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  annotationFile     AnnotationFile?      @relation(fields: [annotationFileId], references: [resourceId], onDelete: SetNull)
  annotationOperation AnnotationOperation? @relation(fields: [annotationOperationId], references: [id], onDelete: SetNull)

  @@index([eventName, invokedAt])
  @@index([annotationFileId, invokedAt])
  @@index([actorUserId, invokedAt])
  @@map("annotation_tool_attempts")
}
