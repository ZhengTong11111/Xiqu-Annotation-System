NODE_ENV=development
DATABASE_URL="postgresql://xiqu:xiqu_dev_password@localhost:54329/xiqu_platform?schema=public"
PORT=4317
HOST=0.0.0.0
XIQU_SEED_DEVELOPMENT_DATA=true
# 开发默认允许跨源；生产同源部署不要设置，独立 Web origin 才填写有限列表。
# XIQU_CORS_ORIGINS=http://127.0.0.1:5173
XIQU_OBJECT_STORAGE_BACKEND=local
XIQU_STORAGE_ROOT="./data/storage"
XIQU_AUTH_TOKEN_DAYS=14
# 配置后才启用 /metrics；监控凭据不要复用平台账号密码或浏览器 session。
XIQU_METRICS_TOKEN=
# 单次运维指标采集超时（毫秒）；超时会暴露失败 Gauge，不会令 /metrics 返回非 Prometheus 内容。
XIQU_OPERATIONAL_METRICS_TIMEOUT_MS=5000
XIQU_MAX_UPLOAD_BYTES=1073741824
XIQU_USER_STORAGE_QUOTA_BYTES=21474836480
XIQU_PLATFORM_STORAGE_QUOTA_BYTES=214748364800
XIQU_ORPHAN_GRACE_MS=86400000

# 阿里云 VOD 默认关闭。启用后凭据只由官方默认凭据链读取，不在数据库或项目 JSON 中保存。
XIQU_ALIYUN_VOD_ENABLED=false
# XIQU_ALIYUN_VOD_REGION=cn-shanghai
# Web 播放器 License 是发送给浏览器的公开授权参数，必须与控制台 Web 应用完全一致并成对设置。
# XIQU_ALIYUN_VOD_WEB_LICENSE_DOMAIN=annotation.example.org
# XIQU_ALIYUN_VOD_WEB_LICENSE_KEY=replace-with-web-license-key

# 独立媒体分析 worker 使用系统 FFmpeg；留空时从 PATH 查找。
# XIQU_FFMPEG_PATH=/usr/bin/ffmpeg

# 强制对齐默认关闭。只有下列绝对路径执行器已经安装、可执行且通过专项验证时，才同时打开请求入口。
XIQU_FORCE_ALIGNMENT_REQUESTS_ENABLED=false
# XIQU_FORCE_ALIGNMENT_EXECUTOR_PATH=/opt/xiqu-platform/bin/force-align

# 远端备份使用独立 S3-compatible 命名空间；prefix 必填且不得与线上对象存储重叠。
XIQU_BACKUP_S3_ENDPOINT=http://127.0.0.1:9000
XIQU_BACKUP_S3_REGION=us-east-1
XIQU_BACKUP_S3_BUCKET=xiqu-backups
XIQU_BACKUP_S3_ACCESS_KEY_ID=replace-me
XIQU_BACKUP_S3_SECRET_ACCESS_KEY=replace-me
XIQU_BACKUP_S3_FORCE_PATH_STYLE=true
XIQU_BACKUP_S3_PREFIX=platform-backups
# 生产部署先按 deploy/object-storage/ 配置最小权限，再执行无残留能力检查。
# 未完成包宽限 24 小时；完整包保留 30 天且始终至少保留最新 3 个。
XIQU_REMOTE_BACKUP_INCOMPLETE_GRACE_MS=86400000
XIQU_REMOTE_BACKUP_RETENTION_DAYS=30
XIQU_REMOTE_BACKUP_MIN_RETAINED=3

# 仅用于隔离恢复演练；必须是与源名称不同、由运维预先创建且归应用账号所有的空数据库。
XIQU_RESTORE_DATABASE_URL=
